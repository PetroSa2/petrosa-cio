# Environment Configuration Example for Petrosa CIO
# Copy this file to .env and fill in your values

# Environment
ENVIRONMENT=production
LOG_LEVEL=INFO

# NATS Configuration
NATS_URL=nats://localhost:4222
REDIS_URL=redis://localhost:6379

# Internal Service URLs
DATA_MANAGER_URL=http://petrosa-data-manager:80
TRADEENGINE_URL=http://petrosa-tradeengine-service:80
TA_BOT_URL=http://petrosa-ta-bot-service:80

# LLM Configuration
# LLM_MODEL_PREFIX is only prepended when the model id does not already start with it
# (avoids openai/openai/... for values like openai/gpt-4o-mini).
LLM_PROVIDER=mock
LLM_MODEL=anthropic/claude-3-haiku-20240307
LLM_FALLBACK_MODEL=openai/gpt-4o-mini
LLM_API_BASE=https://router.requesty.ai/v1
LLM_MODEL_PREFIX=openai/
LLM_SUPPORTS_JSON_MODE=true
# minimal = stripped prompts, no json_object; standard = full schema + json_object when supported
LLM_CAPABILITY_PROFILE=standard
# Enable LLM reasoning for nurse flows; set to false to use deterministic bypass mode
NURSE_USE_LLM_REASONING=true
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
REQUESTY_API_KEY=

# Vector DB Configuration
VECTOR_PROVIDER=mock
QDRANT_URL=
QDRANT_API_KEY=

# Rollout Control
DRY_RUN=true

# OpenTelemetry Configuration (Optional)
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=petrosa-cio

# Net-EV gate (petrosa-cio#296)
CIO_NET_EV_ALPHA=0.20
CIO_NET_EV_PRIOR_STRENGTH=30
# enforce (default) or log_only: compute and log the gate without vetoing
CIO_NET_EV_GATE_MODE=enforce
# log_only (default), enforce or off: the cost-share pre-filter before the LLM call
CIO_COST_SHARE_PREFILTER=log_only

# Drawdown steps at z sigma (petrosa-cio#298)
CIO_DRAWDOWN_Z_REDUCE=2
CIO_DRAWDOWN_Z_HALT=3
CIO_DRAWDOWN_REDUCE_FACTOR=0.5
# enforce (default) or log_only: compute and log the step without acting
CIO_DRAWDOWN_MODE=enforce
# Posterior sizing (petrosa-cio#297)
CIO_KELLY_FRACTION=0.25
# Regime policy (petrosa-cio#294, #326): a stale, low-confidence or missing regime means probe size only
# the confidence below which a regime counts as low (labelled fallback 0.70)
CIO_REGIME_MIN_CONFIDENCE=0.70
# data-manager analytics interval; a regime older than max(3 x this, 1 h) is stale (fallback 900)
CIO_REGIME_ANALYZER_INTERVAL_SECONDS=900

# Realtime-strategies parameter changes (petrosa-cio#332): shadow (default) or apply
CIO_REALTIME_PARAMS_MODE=shadow

# In-position review loop: the most positions it keeps registered (the oldest is evicted past this)
CIO_REVIEW_LOOP_MAX_POSITIONS=200
